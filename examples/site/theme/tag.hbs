{{!< default}}

{{#tag}}
  <header class="tag-header">
    <h1 class="tag-title">{{name}}</h1>
    {{#if description}}
      <p class="tag-description">{{description}}</p>
    {{/if}}
  </header>
{{/tag}}

<section class="post-feed">
  {{#foreach posts}}
    {{> "post-card"}}
  {{/foreach}}
</section>

{{pagination}}
