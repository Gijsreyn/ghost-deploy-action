<article class="post-card {{post_class}}">
  {{#if feature_image}}
    <a class="post-card-image" href="{{url}}">
      <img src="{{img_url feature_image size="m"}}" alt="{{#if feature_image_alt}}{{feature_image_alt}}{{else}}{{title}}{{/if}}" loading="lazy">
    </a>
  {{/if}}

  <h2 class="post-card-title"><a href="{{url}}">{{title}}</a></h2>

  {{#if custom_excerpt}}
    <p class="post-card-excerpt">{{custom_excerpt}}</p>
  {{else}}
    <p class="post-card-excerpt">{{excerpt words="30"}}</p>
  {{/if}}

  <p class="post-card-meta">
    <time datetime="{{date format="YYYY-MM-DD"}}">{{date format="D MMMM YYYY"}}</time>
    {{#primary_tag}}
      in <a href="{{url}}">{{name}}</a>
    {{/primary_tag}}
  </p>
</article>
